# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://sb:replace-with-a-long-random-value@localhost:5433/secondbrain

# Better Auth: one endpoint shared by the website and Tauri
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
# Required in production when the website and API use sibling subdomains (for example: sillagehq.app)
BETTER_AUTH_COOKIE_DOMAIN=
SITE_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# WebAuthn relying-party domain (no scheme) and exact website origins
BETTER_AUTH_PASSKEY_RP_ID=localhost
BETTER_AUTH_PASSKEY_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Magic-link delivery (Cloudflare Email Service REST API)
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_EMAIL_API_TOKEN=replace-me
AUTH_EMAIL_FROM="Sillage <auth@example.com>"

# Server-to-server boundary
MEMORY_INTERNAL_TOKEN=replace-with-an-independent-32-byte-random-value
MEMORY_URL=http://localhost:8000
APP_API_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
MEMORY_CORS_ALLOWED_ORIGINS=http://localhost:3001
# Adaptive recall planner and multi-query retrieval (set to 0 for immediate rollback/A-B baseline)
RETRIEVAL_QUERY_PLANNER=1

# FalkorDB: one instance, one named graph per workspace
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=replace-with-a-long-random-value

# Landing server
API_URL=http://localhost:3001
# Required when building a production desktop release; also configures its Rust watcher.
VITE_API_URL=http://localhost:3001
VITE_SITE_URL=http://localhost:5173
VITE_ACCOUNT_URL=http://localhost:5173/account
VITE_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_POSTHOG_KEY=phc_replace-me
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Landing private-beta waitlist (server-side only)
LUMAIL_API_TOKEN=lum_replace-me
LUMAIL_WAITLIST_TAG=beta
WAITLIST_INTERNAL_TOKEN=replace-with-an-independent-long-random-value
TURNSTILE_SECRET_KEY=replace-me
# Public build-time key for the invisible Turnstile widget
VITE_TURNSTILE_SITE_KEY=replace-me
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_replace-me

# Paddle Billing (website checkout; keep the API key and webhook secret server-side)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=replace-me
PADDLE_PRICE_ID=pri_replace-me
# Optional additional plan prices; PADDLE_PRICE_ID is used as Personal fallback.
PADDLE_PRICE_ID_PERSONAL=pri_replace-me
PADDLE_PRICE_ID_DEEP=pri_replace-me
PADDLE_PRICE_ID_ARCHIVE=pri_replace-me
PADDLE_PRICE_ID_PERSONAL_YEARLY=pri_replace-me
PADDLE_PRICE_ID_DEEP_YEARLY=pri_replace-me
PADDLE_PRICE_ID_ARCHIVE_YEARLY=pri_replace-me
PADDLE_WEBHOOK_SECRET=replace-me
REQUIRE_BILLING_ACCESS=false

# Local vault image OCR (tesseract); OCR text is used for retrieval only.
OCR_IMAGES=1
OCR_MAX_IMAGES=12

# Optional bulk-ingestion script only; set to your own Obsidian vault directory.
SILLAGE_VAULT_PATH=
